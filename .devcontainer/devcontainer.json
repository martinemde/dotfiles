// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
  "name": "Dotfiles Development",
  // Use Debian bookworm base image
  "image": "mcr.microsoft.com/devcontainers/base:bookworm@sha256:99f5250dd2d5f8b11046d5662dd94c1e3c1dae56b560c7caad5ceb7edf349046",
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1@sha256:5c389ab1e3c8e44e5e0ff119f6868d54dbb781bc860bd8587dc66209cb8c4a8c": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4@sha256:fae40f3c8be5a7c3b0db344c1d30341bc2c91ba38d1d5b14cd2ad72e6d65d084": {
      "version": "latest",
      "enableNonRootDocker": "true"
    },
    "ghcr.io/devcontainers/features/git:1@sha256:fd75977de13a9979000e0e78baf949adb0ca71d2398995fa22e0a36d7e7e7fe2": {},
    "ghcr.io/devcontainers/features/github-cli:1@sha256:bd7ab48a832228f633239277552c30b353867fef2e5b037e064b4e64f0b843f2": {}
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "bungcip.better-toml",
        "eamodio.gitlens",
        "jetmartin.bats",
        "mkhl.shfmt",
        "ms-vscode.vscode-json",
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },
        "shellcheck.enable": true,
        "shellcheck.run": "onSave",
        "shfmt.config": {
          "indent": 2,
          "binaryNextLine": false,
          "switchCaseIndent": false,
          "spaceRedirects": false,
          "keepPadding": false,
          "minify": false,
          "simplify": false
        },
        "files.associations": {
          "*.bats": "shellscript"
        },
        "editor.rulers": [80],
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 100
      }
    }
  },
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root",
  // Run the install script and setup development tools after container creation
  "postCreateCommand": "./install.sh && mise trust --yes && ./bin/setup"
}
