#!/bin/bash

# Reject invalid JSON before ~/.claude/settings.json is written.
#
# The body is rendered from the same .chezmoitemplates/claude-settings.json that
# dot_claude/settings.json.tmpl includes, so what gets validated here is exactly
# what chezmoi is about to write. run_before_ means a non-zero exit aborts the
# apply and the bad file never lands.
#
# The heredoc delimiter is quoted: the JSON contains "$defaults", which the
# shell would otherwise expand to nothing.

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

settings=$(
  cat <<'CLAUDE_SETTINGS_JSON'
{{ includeTemplate "claude-settings.json" . }}
CLAUDE_SETTINGS_JSON
)

if command -v jq >/dev/null 2>&1; then
    validate() { printf '%s' "$1" | jq empty; }
elif command -v python3 >/dev/null 2>&1; then
    validate() { printf '%s' "$1" | python3 -c 'import json,sys; json.load(sys.stdin)'; }
else
    echo "warning: no jq or python3, skipping settings.json validation" >&2
    exit 0
fi

if ! validate "$settings"; then
    echo "" >&2
    echo "error: .chezmoitemplates/claude-settings.json renders invalid JSON." >&2
    echo "       Refusing to write ~/.claude/settings.json. Fix the template." >&2
    exit 1
fi
