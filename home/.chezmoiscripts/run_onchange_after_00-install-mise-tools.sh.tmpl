#!/bin/bash

# Run after managed files so ~/.config/mise/config.toml exists on first apply.

# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

# Only run if mise is available
if ! command -v mise >/dev/null 2>&1; then
    echo "WARNING: mise not found, skipping tool installation" >&2
    echo "         Install mise first: https://mise.jdx.dev/getting-started.html" >&2
    exit 0
fi

# Resolve a GitHub token before calling mise install. mise/aqua hit the
# GitHub API for nearly every tool, and unauthenticated requests share a
# stingy per-IP rate limit that gets exhausted within a handful of tools.
# Once exhausted, every subsequent install fails with 403 and we have to
# wait ~1h. Better to refuse upfront than to half-install and rate-limit.
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null)" && export GITHUB_TOKEN
fi

if [ -z "${GITHUB_TOKEN:-}" ] && [ "${MISE_ALLOW_ANONYMOUS_GITHUB:-}" != "1" ]; then
    cat >&2 <<'EOF'
ERROR: No GITHUB_TOKEN available — refusing to run `mise install`.

Anonymous GitHub API requests are rate-limited per IP and will fail
partway through, leaving tools in an inconsistent state.

Fix one of:
  - Install gh and authenticate:  `gh auth login`  (then re-run apply)
  - Export a token:               `export GITHUB_TOKEN=<your PAT>`
  - Override (not recommended):   `export MISE_ALLOW_ANONYMOUS_GITHUB=1`

EOF
    exit 1
fi

echo "Installing global mise tools..."

# Install all tools defined in global config
mise install --yes

# Generate bun completions (installed to site-functions, loaded by compinit).
# The bootstrap shell has not activated mise shims yet, so use the resolved
# binary directly.
BUN=""
if BUN="$(mise which bun 2>/dev/null)"; then
    ZSH_SITE="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions"
    mkdir -p "$ZSH_SITE"
    "$BUN" completions > "$ZSH_SITE/_bun"
fi

echo "Global mise tools installation complete"
