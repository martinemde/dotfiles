#!/bin/bash

# Scan dotfiles and home directory for secrets after chezmoi apply

[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit
set -o nounset

# Resolve gitleaks directly because mise shims may not be active in the
# bootstrap process yet.
GITLEAKS=""
if command -v gitleaks >/dev/null 2>&1; then
    GITLEAKS="$(command -v gitleaks)"
elif command -v mise >/dev/null 2>&1; then
    GITLEAKS="$(mise which gitleaks 2>/dev/null || true)"
fi
if [ -z "$GITLEAKS" ]; then
    echo "⚠️  gitleaks not found, skipping secrets scan"
    echo "   Run 'brew install gitleaks' or './install.sh' to enable scanning"
    exit 0
fi

echo "Scanning dotfiles for secrets..."

# Scan the dotfiles repository (source files in chezmoi working tree)
DOTFILES_DIR="{{ .chezmoi.workingTree }}"
"$GITLEAKS" dir \
  --no-banner \
  --verbose \
  --log-level warn \
  "$DOTFILES_DIR"
"$GITLEAKS" git \
  --no-banner \
  --verbose \
  --log-level warn \
  "$DOTFILES_DIR"

# Scan home directory for common secret files
# Focus on config directories and known secret-prone locations
echo "Scanning home dir for secrets..."
if [ -d "$HOME/.config" ]; then
    # Only warn, don't fail apply
    "$GITLEAKS" dir \
      --config "$HOME/.gitleaks.toml" \
      --no-banner \
      --verbose \
      --log-level warn \
      --max-target-megabytes 10 \
      "$HOME" \
      || true
fi
