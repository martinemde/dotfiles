#!/bin/bash

# LaunchAgent hash: {{ include "private_Library/LaunchAgents/local.dotfiles.homebrew-update.plist.tmpl" | sha256sum }}
[ -n "${DEBUG:-}" ] && set -o xtrace
set -o errexit -o nounset -o pipefail

{{ if ne .chezmoi.os "darwin" }}exit 0{{ end }}
command -v launchctl >/dev/null 2>&1 || exit 0
DOMAIN="gui/$(id -u)"
# A GUI login is required for a user LaunchAgent (not present in containers/CI).
if ! launchctl print "$DOMAIN" >/dev/null 2>&1; then
    echo "No GUI login; Homebrew update agent will need loading after login" >&2
    exit 0
fi
mkdir -p "$HOME/Library/Logs"
launchctl bootout "$DOMAIN/local.dotfiles.homebrew-update" 2>/dev/null || true
launchctl bootstrap "$DOMAIN" "$HOME/Library/LaunchAgents/local.dotfiles.homebrew-update.plist"
