{
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "cleanupPeriodDays": 365,
  "env": {
{{- if eq .hosttype "work" }}
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "GUSTO_CLAUDE_SETUP": "true",
{{- end }}
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1"
  },
{{- if eq .hosttype "work" }}
  "includeCoAuthoredBy": true,
{{- else }}
  "includeCoAuthoredBy": false,
{{- end }}
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(col:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Bash(bats:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(git:*)",
      "Bash(jj:*)",
      "Bash(ruby -c:*)",
      "Bash(bundle:*)",
      "Bash(bin/srb:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/rspec:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(bktide:*)",
      "Bash(tmux:*)",
      "Bash(mise ls:*)",
      "Bash(mise ls-remote:*)",
      "Bash(mise exec:*)",
      "Bash(docker ps:*)",
      "Bash(find:*)",
      "Bash(go:*)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/gh-via-local-shim.sh",
            "if": "Bash(gh *)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jj || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/src/martinemde/starship-claude/plugin/bin/starship-claude",
    "padding": 0
  },
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
  },
  "alwaysThinkingEnabled": true,
{{- if eq .hosttype "work" }}
  "effortLevel": "high",
{{- end }}
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "useAutoModeDuringPlan": true,
  "gitAttribution": false,
  "skipAutoPermissionPrompt": true
}
