{{- /* Include work settings if AWS profile was configured during init */ -}}
{
{{- if .aws.profile }}
  "awsAuthRefresh": "aws sso login --profile $AWS_PROFILE",
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "AWS_PROFILE": {{ .aws.profile | quote }},
    "AWS_REGION": "us-west-2",
    "GUSTO_CLAUDE_SETUP": "true"
  },
  "includeCoAuthoredBy": true,
  "model": "us.anthropic.claude-opus-4-6-v1",
{{- else }}
  "includeCoAuthoredBy": false,
  "model": "opus-4-6",
{{- end }}
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(bats:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(git:*)",
      "Bash(jj:*)",
      "Bash(ruby -c:*)",
      "Bash(bundle:*)",
      "Bash(bin/srb:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/rspec:*)",
      "Bash(tmux:*)"
    ],
    "deny": [],
    "ask": ["Bash(rm:*)"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jj || true"
          }
        ]
      }
    ]
  },
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "statusLine": {
    "type": "command",
    "padding": 0,
    "command": "~/src/martinemde/starship-claude/starship-claude"
  },
  "enabledPlugins": {
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "elements-of-style@superpowers-marketplace": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "episodic-memory@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "gitAttribution": false,
  "cleanupPeriodDays": 90
}
