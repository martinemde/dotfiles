{{- /* Include work settings if AWS profile was configured during init (order intentionally maintained) */ -}}
{
{{- if .aws.profile }}
  "awsAuthRefresh": "aws sso login --profile $AWS_PROFILE",
{{- end }}
  "fileSuggestion": {
    "type": "command",
    "command": "~/.claude/file-suggestion.sh"
  },
  "cleanupPeriodDays": 365,
{{- if .aws.profile }}
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-4-6-v1[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "us.anthropic.claude-opus-4-6-v1[1m]",
    "GUSTO_CLAUDE_SETUP": "true",
  },
  "includeCoAuthoredBy": true,
{{- else }}
  "includeCoAuthoredBy": false,
{{- end }}
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(col:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(jq:*)",
      "Bash(bats:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(git:*)",
      "Bash(jj:*)",
      "Bash(ruby -c:*)",
      "Bash(bundle:*)",
      "Bash(bin/srb:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/rspec:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(bktide:*)",
      "Bash(tmux:*)",
      "Bash(mise ls:*)",
      "Bash(mise ls-remote:*)",
      "Bash(mise exec:*)",
      "Bash(docker ps:*)",
      "Bash(find:*)",
      "Bash(go:*)"
    ],
    "deny": [],
    "ask": [
      "Bash(rm:*)",
      "Bash(jj push:*)",
      "Bash(jj git push:*)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)"
    ]
  },
{{- if .aws.profile }}
  "model": "us.anthropic.claude-opus-4-6-v1[1m]",
{{- end }}
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jj || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/src/martinemde/starship-claude/starship-claude",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "elements-of-style@superpowers-marketplace": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gusto-setup-wizard@gusto-claude-code": true,
    "superpowers@claude-plugins-official": true,
    "ci-cd-tools@pickled-claude-plugins": true,
    "playground@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "dev-tools@pickled-claude-plugins": true,
    "ruby-lsp@claude-plugins-official": true,
    "agent-meta@pickled-claude-plugins": true,
    "second-brain@pickled-claude-plugins": true,
    "stay-on-target@pickled-claude-plugins": true,
    "tool-routing@pickled-claude-plugins": true,
    "working-in-monorepos@pickled-claude-plugins": true

    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "pickled-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "technicalpickles/pickled-claude-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "gitAttribution": false
}
