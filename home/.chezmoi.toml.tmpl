# Chezmoi Configuration File Template
# This template is processed during `chezmoi init` to create the actual config file.
# Variables are prompted from the user and stored in the [data] section.

# Source Directory Configuration
# Allows us to maintain Chezmoi outside of the default `~/.local/share/chezmoi/`.
# This enables storing the dotfiles repository in a custom location while still
# using chezmoi for management. The workingTree variable points to the repo root.
# NOTE: I moved this to the standard location so this is commented now.
# sourceDir = "{{ .chezmoi.workingTree }}"

# Data Section
# Variables defined here are available in all templates via the .data namespace.
# These values can be referenced in template files throughout the dotfiles repo.

{{- /* Non-interactive mode: auto-detect no TTY or set CHEZMOI_NONINTERACTIVE=1 */ -}}
{{- $interactive := and (stdinIsATTY) (not (env "CHEZMOI_NONINTERACTIVE")) -}}

{{- $choices := list "home" "work" -}}
{{- $hosttype := "home" -}}
{{- if $interactive -}}
  {{- $hosttype = promptChoiceOnce . "hosttype" "Which host" $choices "home" -}}
{{- else if env "CHEZMOI_HOSTTYPE" -}}
  {{- $hosttype = env "CHEZMOI_HOSTTYPE" -}}
{{- end }}

[data]
hosttype = {{ $hosttype | quote }}

{{- /* Cache signing key after first init so re-init and SSH sessions skip 1Password */ -}}
{{- $gitSigningKey := dig "git" "signingkey" "" . }}
{{- if lookPath "op" }}
  {{- $gitSigningKeyRef := "op://Private/GitHub SSH Signing Key/public key" }}
  {{- if eq $hosttype "work" -}}
    {{- $gitSigningKeyRef = "op://Employee/GitHub SSH Signing Key/public key" }}
  {{- end -}}
  {{- if and (not $gitSigningKey) $interactive -}}
    {{- $gitSigningKey = onepasswordRead $gitSigningKeyRef }}
  {{- end -}}
{{- end }}
[data.git]
# Git user configuration - prompted during initialization
# Used in git config templates and other version control settings
name = "Martin Emde"
email = "me@martinemde.com"
signingkey = {{ $gitSigningKey | quote }}

[diff]
format = "git"
pager = "delta"

# vim: ft=toml
