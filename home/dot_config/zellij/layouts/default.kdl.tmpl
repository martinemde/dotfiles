{{- $os_icon := "󰌽" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $os_icon = "󰀵" -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $id := .chezmoi.osRelease.id | default "" -}}
{{-   $icons := dict "fedora" "󰣛" "debian" "󰣚" "ubuntu" "󰕈" "raspbian" "" -}}
{{-   $os_icon = get $icons $id | default $os_icon -}}
{{-   if and (or (eq $id "debian") (eq $id "raspbian")) (contains "rpi" .chezmoi.kernel.osrelease) -}}
{{-     $os_icon = "" -}}
{{-   end -}}
{{- end -}}
// Default zellij layout with zjstatus status bar
// Theme: catppuccin-espresso (matches themes.catppuccin-espresso in config.kdl)
// zjstatus: https://github.com/dj95/zjstatus
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "#[fg=#CBA6F7] {{ $os_icon }} {mode}#[fg=#89B4FA,bold] {session}"
                format_center "{tabs}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                // Keep navigation; drop the clock/branch, then session/mode if crowded.
                format_hide_on_overlength "true"
                format_precedence "clr"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6C7086]{char}"
                border_position "top"

                hide_frame_for_single_pane "false"

                mode_normal  "#[bg=#89B4FA,fg=#11111D,bold] NORMAL "
                mode_tmux    "#[bg=#FAB387,fg=#11111D,bold] TMUX "
                mode_locked  "#[bg=#F38BA8,fg=#11111D,bold] LOCKED "
                mode_pane    "#[bg=#A6E3A1,fg=#11111D,bold] PANE "
                mode_tab     "#[bg=#CBA6F7,fg=#11111D,bold] TAB "
                mode_resize  "#[bg=#F9E2AF,fg=#11111D,bold] RESIZE "
                mode_move    "#[bg=#94E2D5,fg=#11111D,bold] MOVE "
                mode_scroll  "#[bg=#89DCEB,fg=#11111D,bold] SCROLL "
                mode_session "#[bg=#F5C2E7,fg=#11111D,bold] SESSION "

                tab_normal   "#[fg=#6C7086] {name} "
                tab_active   "#[fg=#CDD6F4,bold,italic] {name} "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#89B4FA] {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                datetime        "#[fg=#6C7086,bold] {format} "
                datetime_format "%H:%M"
                datetime_timezone "America/Los_Angeles"
            }
        }
    }
}
