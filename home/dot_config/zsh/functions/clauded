#!/usr/bin/env zsh
local task_list_id=""
local args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --list)
      if [[ -n "${2:-}" && "${2:0:1}" != "-" ]]; then
        task_list_id="$2"
        shift 2
      else
        task_list_id="project-$(pwd | sed 's|^/||' | tr '/.' '-')"
        shift
      fi
      ;;
    --list=*)
      task_list_id="${1#--list=}"
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$task_list_id" ]]; then
  CLAUDE_CODE_TASK_LIST_ID="$task_list_id" claude --dangerously-skip-permissions "${args[@]}"
else
  claude --dangerously-skip-permissions "${args[@]}"
fi
