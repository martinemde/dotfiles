# ============================================================================
# Tool Integrations
# ============================================================================

{{- if eq .chezmoi.os "darwin" }}
# Homebrew - ensure brew binaries come before system binaries
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}

# 1Password CLI plugins (aliases like gh to use op)
[[ -f "$XDG_CONFIG_HOME/op/plugins.sh" ]] && source "$XDG_CONFIG_HOME/op/plugins.sh"

# Shim mode (--shims) puts ~/.local/share/mise/shims on PATH so tools resolve
# through mise in subprocesses and non-interactive shells. Gusto's scope doctor
# (bundler-shims check) requires this; plain hook mode doesn't expose the shims dir.
eval "$(mise activate zsh --shims)"
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "thria") }}
# The op plugin may alias gh; only the broker owns GitHub auth on Thria.
unalias gh 2>/dev/null || true
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)
{{- end }}

(( $+commands[atuin] ))    && znap eval atuin 'atuin init zsh'
# starship bakes its absolute binary path into the cached init; drop the cache when mise moves it
_starship_cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh-snap/eval/starship.zsh
[[ -r $_starship_cache && $(<$_starship_cache) =~ "'(/[^']*/starship)'" && ! -x $match[1] ]] &&
  rm -f $_starship_cache{,.zwc}
unset _starship_cache
(( $+commands[starship] )) && znap eval starship 'starship init zsh'
(( $+commands[zoxide] ))   && znap eval zoxide 'zoxide init zsh'
(( $+commands[jj] ))       && znap eval jj 'COMPLETE=zsh jj'
(( $+commands[thefuck] ))  && znap eval thefuck 'thefuck --alias'

