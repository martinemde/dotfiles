# ============================================================================
# Tool Integrations
# ============================================================================

# Homebrew - ensure brew binaries come before system binaries
eval "$(/opt/homebrew/bin/brew shellenv)"

# 1Password CLI plugins (aliases like gh to use op)
[[ -f "$XDG_CONFIG_HOME/op/plugins.sh" ]] && source "$XDG_CONFIG_HOME/op/plugins.sh"

# bun completions
[[ -s "/Users/martinemde/.bun/_bun" ]] && source "/Users/martinemde/.bun/_bun"

# mise manages its own hooks, run directly (don't cache)
eval "$(mise activate zsh)"

# disable rv temporarily, it causes issues with gems
# znap eval rv 'rv shell init zsh' # rv - ruby manager
znap eval atuin 'atuin init zsh' # atuin - magical shell history
znap eval starship 'starship init zsh' # starship - cross-shell prompt
znap eval zoxide 'zoxide init zsh' # zoxide - smarter cd command
znap eval jj 'COMPLETE=zsh jj'
znap eval thefuck 'thefuck --alias'

# vi: ft=zsh
