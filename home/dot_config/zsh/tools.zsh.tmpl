# ============================================================================
# Tool Integrations
# ============================================================================

{{- if eq .chezmoi.os "darwin" }}
# Homebrew - ensure brew binaries come before system binaries
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}

# 1Password CLI plugins (aliases like gh to use op)
[[ -f "$XDG_CONFIG_HOME/op/plugins.sh" ]] && source "$XDG_CONFIG_HOME/op/plugins.sh"

# mise manages its own hooks, run directly (don't cache)
eval "$(mise activate zsh)"

# disable rv temporarily, it causes issues with gems
# znap eval rv 'rv shell init zsh' # rv - ruby manager
(( $+commands[atuin] ))    && znap eval atuin 'atuin init zsh'
(( $+commands[starship] )) && znap eval starship 'starship init zsh'
(( $+commands[zoxide] ))   && znap eval zoxide 'zoxide init zsh'
(( $+commands[jj] ))       && znap eval jj 'COMPLETE=zsh jj'
(( $+commands[thefuck] ))  && znap eval thefuck 'thefuck --alias'

# vi: ft=zsh
