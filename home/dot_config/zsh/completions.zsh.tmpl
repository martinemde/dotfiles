# ============================================================================
# Completion System Configuration
# ============================================================================

# Add custom functions and completions directories to fpath
fpath=(
  "$XDG_CONFIG_HOME/zsh/functions"
  "$XDG_CONFIG_HOME/zsh/completions"
  "${fpath[@]}"
)

# Autoload custom functions
autoload -Uz $XDG_CONFIG_HOME/zsh/functions/*(:t)

# Initialize completion system
autoload -Uz compinit
compinit

# Load dynamic tool completions
(( $+commands[jj] )) && source <(jj util completion zsh)
# Note: rv completions are generated once into site-functions by the brew
# bundle script (see run_onchange_darwin_brew_bundle). Using `znap fpath`
# here regenerated and recompiled _rv on every startup, which raced across
# concurrent shells (zellij panes) and produced _rv.zwc chmod errors.

# vi: ft=zsh
