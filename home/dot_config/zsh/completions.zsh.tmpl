# ============================================================================
# Completion System Configuration
# ============================================================================

# Add custom functions and completions directories to fpath
fpath=(
  "$XDG_CONFIG_HOME/zsh/functions"
  "$XDG_CONFIG_HOME/zsh/completions"
  "${fpath[@]}"
)

# Autoload custom functions
autoload -Uz $XDG_CONFIG_HOME/zsh/functions/*(:t)

# Initialize completion system
autoload -Uz compinit
compinit

# Load dynamic tool completions
(( $+commands[jj] )) && source <(jj util completion zsh)
(( $+commands[rv] )) && znap fpath _rv 'rv shell completions zsh'

