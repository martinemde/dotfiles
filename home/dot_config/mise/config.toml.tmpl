#:schema https://mise.jdx.dev/schema/mise.json
# Compatibility floor for the verification and lock semantics tested here.
min_version = "2026.10.25"

[tools]
"aqua:ajeetdsouza/zoxide" = "latest"
"aqua:ast-grep/ast-grep" = "latest"
"aqua:atuinsh/atuin" = "latest"
"aqua:aws/aws-cli" = "latest"
"aqua:bootandy/dust" = "latest"
"aqua:BurntSushi/ripgrep" = "latest"
"aqua:charmbracelet/glow" = "latest"
"aqua:cli/cli" = "latest"
"aqua:neovim/neovim" = "latest"
{{ if ne .chezmoi.os "darwin" -}}
"aqua:eza-community/eza" = "latest"
{{ end -}}
"aqua:Kitware/CMake" = "latest"
"aqua:jgm/pandoc" = "latest"
"aqua:dandavison/delta" = "latest"
"aqua:eth-p/bat-extras" = "latest"
"aqua:evilmartians/lefthook" = "latest"
"aqua:FiloSottile/mkcert" = "latest"
"aqua:git-lfs/git-lfs" = "latest"
"aqua:gitleaks/gitleaks" = "latest"
"aqua:hashicorp/terraform" = "latest"
"aqua:jesseduffield/lazygit" = "latest"
"aqua:jj-vcs/jj" = "latest"
"aqua:jqlang/jq" = "latest"
"aqua:junegunn/fzf" = "latest"
"aqua:koalaman/shellcheck" = "latest"
"aqua:mikefarah/yq" = "latest"
"aqua:muesli/duf" = "latest"
"aqua:pre-commit/pre-commit" = "latest"
"aqua:sharkdp/bat" = "latest"
"aqua:sharkdp/fd" = "latest"
"aqua:sigstore/cosign" = "latest"
"aqua:starship/starship" = "latest"
"aqua:superfly/flyctl" = "latest"
# Agent/env detection, used by zsh/aliases.zsh to skip agent-hostile aliases.
# Pinned: the alias guard depends on `envsense check agent` exit-code semantics.
"aqua:technicalpickles/envsense" = "0.3.0"
"aqua:tree-sitter/tree-sitter" = "latest"
"aqua:zellij-org/zellij" = "latest"
"go:golang.org/x/tools/gopls" = "latest"
bun = "latest"
codex = "latest"
go = "latest"
node = "latest"
pnpm = "latest"
# Require artifact attestations for precompiled CPython instead of a release delay.
python = { version = "latest", minimum_release_age = "0s" }
uv = "latest"
ansible-core = "latest"

{{ if eq .chezmoi.os "darwin" -}}
{{ $brewPrefix := "/usr/local" -}}
{{ if eq .chezmoi.arch "arm64" }}{{ $brewPrefix = "/opt/homebrew" }}{{ end -}}
[env]
# Keep CLI trust on Homebrew's updated bundle, including its eMudhra exclusions.
SSL_CERT_FILE = "{{ $brewPrefix }}/etc/ca-certificates/cert.pem"
REQUESTS_CA_BUNDLE = "{{ $brewPrefix }}/etc/ca-certificates/cert.pem"
NODE_OPTIONS = "--use-openssl-ca"

{{ end -}}
[settings]
# Keep shims, exec, and tasks from installing tools as a side effect.
auto_install = false
# A missing configured shim must not run an unrelated tool from PATH.
not_found_system_fallback = false
idiomatic_version_file_enable_tools = ["ruby"]
# Exact pins and existing lock entries bypass the age filter; review those updates.
minimum_release_age = "7d"
locked_verify_provenance = true
provenance_api_failures_fatal = true
github_attestations = true
slsa = true

[settings.aqua]
cosign = true
github_attestations = true
minisign = true
slsa = true

[settings.node]
verify = true

[settings.go]
skip_checksum = false

[settings.github]
use_git_credentials = true

[settings.python]
# Do not silently fall back to an unverified source build.
compile = false
github_attestations = true

# Applies only to mise self-update; package-manager updates keep their own policy.
[settings.self_update]
minimum_release_age = "0s"

[settings.ruby]
compile = false
