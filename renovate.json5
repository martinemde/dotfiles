{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>martinemde/renovate-config#v1.0.0"],
  enabledManagers: [
    "pip_requirements",
    "mise",
    "docker-compose",
    "devcontainer",
    "github-actions",
    "npm",
    "custom.regex",
    "custom.jsonata",
    "renovate-config",
  ],
  constraints: { mise: "2026.11.7" },
  lockFileMaintenance: { enabled: true, schedule: ["at any time"] },
  mise: {
    managerFilePatterns: ["/^\\.mise\\.toml$/", "/^home/dot_config/mise/config\\.toml$/"],
  },
  "github-actions": {
    managerFilePatterns: ["/^\\.github/workflows/.*\\.ya?ml$/"],
  },
  pip_requirements: {
    managerFilePatterns: ["/^home/dot_config/dotfiles/requirements\\.txt$/"],
  },
  devcontainer: {
    managerFilePatterns: ["/^\\.devcontainer/devcontainer\\.json$/"],
  },
  "docker-compose": {
    managerFilePatterns: ["/^home/dot_config/docker-compose/.*\\.ya?ml$/"],
  },
  npm: {
    managerFilePatterns: [
      "/^package\\.json$/",
      "/^home/dot_config/dotfiles/package\\.json$/",
    ],
  },
  packageRules: [
    // Personal dotfiles favor tested updates and rollback over manual version review.
    {
      matchUpdateTypes: ["major"],
      automerge: true,
    },
    {
      matchPackageNames: ["mise", "jdx/mise", "chezmoi", "twpayne/chezmoi", "uv", "astral-sh/uv", "bun", "oven-sh/bun"],
      minimumReleaseAge: "12 hours",
    },
    {
      matchPackageNames: ["jdx/mise"],
      groupName: "mise runtime",
    },
    // Global multi-backend lock coverage is incomplete; do not fabricate a lock.
    {
      matchFileNames: ["home/dot_config/mise/config.toml"],
      lockFileMaintenance: { enabled: false },
    },
    // Major-update permission must not override the shared security-review exception.
    {
      matchJsonata: ["isVulnerabilityAlert = true"],
      automerge: false,
    },
    // Policy changes need review even when the preset publishes a minor release.
    {
      matchManagers: ["renovate-config"],
      automerge: false,
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github-actions",
      matchUpdateTypes: ["minor", "patch", "digest"],
    },
    {
      matchManagers: ["devcontainer"],
      groupName: "devcontainer",
      matchUpdateTypes: ["minor", "patch", "digest"],
    },
    {
      matchManagers: ["docker-compose"],
      groupName: "docker-compose",
      matchUpdateTypes: ["digest"],
    },
    {
      matchManagers: ["pip_requirements"],
      groupName: "python-tools",
      matchUpdateTypes: ["minor", "patch"],
    },
    {
      matchManagers: ["mise"],
      groupName: "mise-tools",
    },
    {
      matchPackageNames: ["chezmoi", "twpayne/chezmoi"],
      groupName: "chezmoi",
    },
    {
      matchManagers: ["npm"],
      groupName: "node-tools",
      rangeStrategy: "pin",
      matchFileNames: ["package.json", "home/dot_config/dotfiles/package.json"],
    },
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["npm"],
      matchFileNames: ["home/dot_pi/private_agent/settings.json"],
      groupName: "pi-extensions",
    },
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-release-attachments"],
      matchFileNames: ["home/.chezmoiexternals/zellij.externals.toml"],
      groupName: "zellij-plugins",
    },

  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^home/dot_config/nvim/lua/plugins/chezmoi\\.lua$/"],
      matchStrings: ['commit = "(?<currentDigest>[a-f0-9]{40})"'],
      datasourceTemplate: "github-digest",
      currentValueTemplate: "main",
      depNameTemplate: "xvzc/chezmoi.nvim",
      packageNameTemplate: "xvzc/chezmoi.nvim",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/", "/^renovate\\.json5$/"],
      matchStrings: [
        'version: (?<currentValue>[0-9.]+) # mise',
        'constraints:\\s*[{]\\s*mise:\\s*"(?<currentValue>[0-9.]+)"\\s*[,}]',
      ],
      depNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^home/dot_config/dotfiles/cli-versions\\.toml$/"],
      matchStrings: ['(?:^|\\n)chezmoi\\s*=\\s*"(?<currentValue>v?[^"\\n]+)"'],
      depNameTemplate: "twpayne/chezmoi",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "/^home\\/dot_pi\\/private_agent\\/settings\\.json$/",
      ],
      matchStrings: [
        '"npm:(?<depName>(?:@[^/"\\s]+/)?[^@"\\s]+)@(?<currentValue>[^"\\s]+)"',
      ],
      datasourceTemplate: "npm",
      versioningTemplate: "npm",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^home/dot_config/dotfiles/cli-versions\\.toml$/"],
      matchStrings: ['(?:^|\\n)cosign\\s*=\\s*"(?<currentValue>v?[^"]+)"'],
      depNameTemplate: "sigstore/cosign",
      datasourceTemplate: "github-releases",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^home/dot_config/go-tools/tools\\.txt$/"],
      matchStrings: ["^(?<depName>[^\\s@]+)@(?<currentValue>v?[^\\s#]+)"],
      datasourceTemplate: "go",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^home/dot_config/node-tools/tools\\.txt$/"],
      matchStrings: ["^(?<depName>[^@\\n]+)@(?<currentValue>[^\\n#]+)"],
      datasourceTemplate: "npm",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^home/\\.chezmoiexternal\\.toml\\.tmpl$/"],
      matchStrings: [
        "ohmyzsh/ohmyzsh/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz",
      ],
      datasourceTemplate: "github-digest",
      currentValueTemplate: "master",
      depNameTemplate: "ohmyzsh/ohmyzsh",
      packageNameTemplate: "ohmyzsh/ohmyzsh",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "/^home/\\.chezmoiexternals/zsh\\.externals\\.toml$/",
      ],
      matchStrings: [
        "zsh-users/zsh-autosuggestions/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz",
      ],
      datasourceTemplate: "github-digest",
      currentValueTemplate: "master",
      depNameTemplate: "zsh-users/zsh-autosuggestions",
      packageNameTemplate: "zsh-users/zsh-autosuggestions",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "/^home/\\.chezmoiexternals/zsh\\.externals\\.toml$/",
      ],
      matchStrings: [
        "zsh-users/zsh-syntax-highlighting/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz",
      ],
      datasourceTemplate: "github-digest",
      currentValueTemplate: "master",
      depNameTemplate: "zsh-users/zsh-syntax-highlighting",
      packageNameTemplate: "zsh-users/zsh-syntax-highlighting",
    },
    {
      customType: "jsonata",
      fileFormat: "yaml",
      managerFilePatterns: ["/^home/\\.chezmoidata/tmux-plugins\\.yaml$/"],
      matchStrings: [
        'tmuxPlugins.{"depName": repo, "currentValue": branch, "currentDigest": commit}',
      ],
      datasourceTemplate: "github-digest",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "/^home/\\.chezmoiexternals/zsh\\.externals\\.toml$/",
      ],
      matchStrings: [
        "marlonrichert/zsh-snap/archive/(?<currentDigest>[a-f0-9]{7,40})\\.tar\\.gz",
      ],
      datasourceTemplate: "github-digest",
      currentValueTemplate: "main",
      depNameTemplate: "marlonrichert/zsh-snap",
      packageNameTemplate: "marlonrichert/zsh-snap",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "/^home/\\.chezmoiexternals/pi\\.externals\\.toml$/",
      ],
      matchStrings: [
        "lepht/pi-pr-session-title/raw/(?<currentDigest>[a-f0-9]{40})/",
      ],
      datasourceTemplate: "github-digest",
      currentValueTemplate: "main",
      depNameTemplate: "lepht/pi-pr-session-title",
      packageNameTemplate: "lepht/pi-pr-session-title",
    },
    {
      customType: "regex",
      managerFilePatterns: [
        "/^home/\\.chezmoiexternals/zellij\\.externals\\.toml$/",
      ],
      matchStrings: [
        'url = "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/(?<currentValue>v?[0-9.]+)/[^"\\n]+"\\nchecksum\\.sha256 = "(?<currentDigest>[a-f0-9]{64})"',
      ],
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "loose",
    },
  ],
}
